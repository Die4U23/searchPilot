# SearchPilot 环境变量示例（复制为 .env 后按需修改；.env 不入库）。
# 应用配置使用 SEARCHPILOT_ 前缀；容器及 glibc 选项单独标注。

# PostgreSQL 连接串。未设置（或留空）时反馈使用内存实现，/health/ready 不出现 database 检查项。
# SEARCHPILOT_DATABASE_URL=postgresql://searchpilot:searchpilot@localhost:5432/searchpilot

# 数据目录（processed Parquet 等）。默认 ./data
SEARCHPILOT_DATA_DIR=./data

# 索引与模型产物目录。默认 ./artifacts
SEARCHPILOT_ARTIFACT_DIR=./artifacts

# 启动时实际编码一次；Python 默认 false，Docker/Compose 默认 true。
# 将模型初始化成本移至启动；失败时保留 BM25，向量未就绪。取消注释可覆盖。
# SEARCHPILOT_VECTOR_WARMUP=true

# 仅容器入口：默认禁用本 Linux 进程的透明大页，避免稀疏映射后台合并增加 RSS。
# false 清除进程禁用标志，恢复系统策略；不修改宿主设置。修改后重建 API 容器。
# SEARCHPILOT_DISABLE_THP=true

# 仅 Linux/glibc 容器：限制 arena 数，减少持续并发下空闲分配区的内存留存。
# 必须在 Python 进程启动前设置；0 恢复 glibc 自动上限。修改后重建 API 容器。
# MALLOC_ARENA_MAX=2

# 指定加载 data/processed/<data_version>；未设置则取目录中唯一的一个。
# SEARCHPILOT_DATA_VERSION=

# query 最大字符数（去首尾空白后）。默认 256
SEARCHPILOT_MAX_QUERY_CHARS=256

# limit 上限。默认 100
SEARCHPILOT_MAX_LIMIT=100

# 日志级别：DEBUG / INFO / WARNING / ERROR。默认 INFO
SEARCHPILOT_LOG_LEVEL=INFO

# 数据库连接池大小。默认 1 / 4
SEARCHPILOT_DB_POOL_MIN=1
SEARCHPILOT_DB_POOL_MAX=4

# 可选调用方令牌。留空则不检查。设置后，除 /health/live 外需要
# Authorization: Bearer <token>。POST /feedback 还需要 X-Actor 与 user_id 相同。
# SEARCHPILOT_API_TOKEN=

# 仅 docker-compose 使用：compose 内 PostgreSQL 的密码
# POSTGRES_PASSWORD=searchpilot

# 多步只读 Agent：Python 入口需安装 .[agent]，并显式导出环境变量（不自动读取 .env）。
# 默认 deterministic 不调用外部模型。llm 模式允许有预算的真实模型请求。
# Docker 使用 docker-compose.agent.yml 作为第二份配置，显式启用 llm 模式。
# SEARCHPILOT_AGENT_MODE=llm
# SEARCHPILOT_AGENT_LLM_ENDPOINT=https://provider.example/v1/chat/completions
# SEARCHPILOT_AGENT_LLM_MODEL=your-model
# SEARCHPILOT_AGENT_LLM_API_KEY=
# SEARCHPILOT_AGENT_MAX_STEPS=8
# SEARCHPILOT_AGENT_TIMEOUT_SECONDS=90
# SEARCHPILOT_AGENT_MAX_CONCURRENT_RUNS=2
